# Copy to .env (never commit .env)

# Next.js → .NET API
NEXT_PUBLIC_BOOKING_API_URL=http://localhost:5116

# Optional: override default demo member (must match Members row in SQL)
# NEXT_PUBLIC_DEMO_MEMBER_EMAIL=your-member@example.com
# NEXT_PUBLIC_DEMO_MEMBER_PASSWORD=demo.member

# Optional: SMTP for legacy Prisma email path (confirmation uses .NET API when integrated)
# SMTP_USER=
# SMTP_PASS=
