# Copy to .env (never commit .env)

# Next.js → .NET API
NEXT_PUBLIC_BOOKING_API_URL=http://localhost:5116

# Optional: override default demo member (must match backend DemoAuth in appsettings.Development.json)
# NEXT_PUBLIC_DEMO_MEMBER_EMAIL=demo.member@wynn.local
# NEXT_PUBLIC_DEMO_MEMBER_PASSWORD=demo.member

# Optional: SMTP for legacy Prisma email path (confirmation uses .NET API when integrated)
# SMTP_USER=
# SMTP_PASS=
