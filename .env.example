# Copy to .env (never commit .env)
# Local URL defaults: config/development.defaults.json (override below if needed)

# Next.js → ASP.NET Core API (optional; defaults from config/development.defaults.json)
# NEXT_PUBLIC_BOOKING_API_URL=

# Public site origin for confirmation links (optional)
# NEXT_PUBLIC_APP_URL=

# Optional: override default demo member (must match Members row in SQL)
# NEXT_PUBLIC_DEMO_MEMBER_EMAIL=your-member@example.com
# NEXT_PUBLIC_DEMO_MEMBER_PASSWORD=demo.member

# Optional: SMTP for legacy Prisma email path (confirmation uses .NET API when integrated)
# SMTP_USER=
# SMTP_PASS=

# Unified audit log (UI + API + DB). Default: logs/wynn-booking-audit.jsonl
# AUDIT_LOG_PATH=logs/wynn-booking-audit.jsonl
