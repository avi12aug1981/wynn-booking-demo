# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets; example template is allowed
.env
.env.*
!.env.example

# .NET build output and local secrets
**/bin/
**/obj/
backend/Wynn.Booking.Api/appsettings.Development.json
backend/publish/
backend/deploy.zip

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

dev.db
prisma/dev.db

# Local AI / editor config (not for the repo)
CLAUDE.md
claude.md
.vscode/

# Local application logs
logs/*.log
backend/Wynn.Booking.Api/logs/

# Personal / interview-only (keep local; do not push)
docs/INTERVIEW-QA.md
docs/PRESENTATION.md
docs/DEMO-SCRIPT.md
docs/screenshots/*.png
docs/screenshots/*.jpg
docs/screenshots/*.jpeg
docs/screenshots/*.webp

# Optional local demo overrides (see .env.example)
app/constants/demo-user.local.ts
